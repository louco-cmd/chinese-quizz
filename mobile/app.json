{
  "expo": {
    "name": "Jiayou",
    "slug": "jiayou",
    "scheme": "jiayou",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/7ad38d6b-0ac0-434f-a29b-a88c41bf6994"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.jiayou.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.jiayou.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1a6ff7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.722514557052-iu88tafpkm7tef0a1njda1053bf8dtg2"
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ad38d6b-0ac0-434f-a29b-a88c41bf6994"
      }
    }
  }
}
