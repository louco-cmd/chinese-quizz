<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Jiayou · Teachers</title>
  <%- include('partials/meta', { pageTitle: 'Jiayou · Teachers', pageDescription: 'Find a Chinese teacher.' }) %>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    .mentor-card { background:#fff; border:none; border-radius:16px; padding:14px 16px; margin-bottom:12px; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .mentor-head { display:flex; align-items:flex-start; gap:12px; }
    .mentor-avatar { width:44px; height:44px; border-radius:50%; flex-shrink:0; background:#e3f0ff; color:#0d6efd; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:1.05rem; }
    .mentor-name { font-weight:800; color:#0d6efd; font-size:1.02rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .mentor-langs { font-size:.8rem; color:#7a8aa8; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .mentor-bio { color:#495267; font-size:.86rem; margin-top:8px; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
    .mentor-footer { display:flex; align-items:center; gap:10px; margin-top:10px; }
    .m-pill { background:#eef4ff; border:1px solid #d5e5fb; border-radius:999px; padding:4px 10px; font-size:.76rem; color:#5a6b8a; white-space:nowrap; flex-shrink:0; }
    .m-pill b { color:#0d6efd; }
    .m-pill.price { background:#e8f8ef; border-color:#c9edd8; color:#1a7a45; }
    .m-pill.price b { color:#12833f; }
    .mentor-stats { font-size:.78rem; color:#8a97ac; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .mentor-cta { display:inline-flex; align-items:center; gap:5px; background:none; border:none; padding:0; margin-top:2px; color:#495057; font-weight:600; font-size:.82rem; text-decoration:none; white-space:nowrap; flex-shrink:0; }
    .mentor-cta:hover { color:#212529; text-decoration:underline; }
    .empty-state { text-align:center; color:#8a97ac; padding:44px 20px; }

    /* ── Tuile de filtres ── */
    .filter-card { background:#fff; border:none; border-radius:16px; padding:14px 16px; margin-bottom:16px; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .filter-label { font-size:.72rem; font-weight:700; color:#999; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.5rem; }
    .filter-chips { display:flex; flex-wrap:wrap; gap:8px; }
    .f-chip { border:1.5px solid #dbe3f1; background:#fff; color:#5a6b8a; border-radius:999px; padding:5px 13px; font-size:.82rem; font-weight:600; cursor:pointer; transition:all .15s ease; user-select:none; }
    .f-chip:hover { border-color:#a9c0e8; }
    .f-chip.active { background:#0d6efd; border-color:#0d6efd; color:#fff; }
    .filter-divider { border:none; border-top:1px solid #eef0f4; margin:12px -16px; }

    /* Join a class (carte façon "Start a duel", sans picto) */
    .join-start-card { background:linear-gradient(135deg,#0d6efd,#0a58ca); border-radius:16px; color:#fff; cursor:pointer; position:relative; transition:transform .2s ease, box-shadow .2s ease; }
    .join-start-arrow { position:absolute; top:10px; right:12px; font-size:1.2rem; color:rgba(255,255,255,.7); transition:transform .25s ease, color .25s ease; pointer-events:none; }
    .join-start-title { font-weight:700; font-size:1.1rem; margin-bottom:2px; }
    .join-start-text { font-size:.85rem; opacity:.85; }
    @media (hover:hover) { .join-start-card:hover { transform:translateY(-3px); box-shadow:0 10px 22px rgba(0,0,0,.18); } .join-start-card:hover .join-start-arrow { transform:translateX(4px); color:#fff; } }
    .join-start-card:active { transform:scale(.97); }
  </style>
</head>
<body>
  <%- include('partials/header', { currentPage: 'mentors' }) %>
  <%- include('partials/navbar', { currentPage: 'mentors' }) %>

  <div class="container py-4">
    <!-- Join a class + Invite your teacher (côte à côte) -->
    <div class="cta-duo mb-4">
      <div class="join-start-card" role="button" tabindex="0"
           data-bs-toggle="modal" data-bs-target="#joinClassModal"
           onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
        <i class="join-start-arrow bi bi-arrow-right-circle-fill"></i>
        <div class="text-center py-3 px-3">
          <div class="join-start-title">Join a class</div>
          <div class="join-start-text">Enter a code</div>
        </div>
      </div>

      <div class="invite-launch-card" role="button" tabindex="0"
           onclick="openInviteModal('teacher')"
           onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openInviteModal('teacher');}">
        <i class="invite-launch-arrow bi bi-arrow-right-circle-fill"></i>
        <div class="text-center py-3 px-3">
          <div class="invite-launch-title">Invite your teacher</div>
          <div class="invite-launch-text">Earn 150 coins</div>
        </div>
      </div>
    </div>

    <!-- Tuile filtres -->
    <div class="filter-card" id="filterCard" style="display:none;">
      <div class="filter-label"><i class="bi bi-translate me-1"></i>Language taught</div>
      <div class="filter-chips" id="langFilters"></div>
      <hr class="filter-divider">
      <div class="filter-label"><i class="bi bi-cash-coin me-1"></i>Price per session</div>
      <div class="filter-chips" id="priceFilters">
        <span class="f-chip active" data-price="any">Any price</span>
        <span class="f-chip" data-price="0-20">≤ €20</span>
        <span class="f-chip" data-price="20-40">€20–40</span>
        <span class="f-chip" data-price="40+">€40+</span>
      </div>
    </div>

    <div id="mentors-list">
      <div class="mentor-card"><div class="mentor-head"><div class="skeleton skeleton-circle" style="width:52px;height:52px;"></div><div class="flex-grow-1"><div class="skeleton skeleton-text" style="width:40%;"></div><div class="skeleton skeleton-text" style="width:60%;"></div></div></div></div>
    </div>
  </div>

  <!-- Modal : rejoindre une classe -->
  <div class="modal fade" id="joinClassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content" style="border-radius:18px;">
        <div class="modal-body p-4 text-center">
          <div style="font-size:2.5rem;">🎒</div>
          <h6 class="fw-bold mt-2 mb-1">Join a class</h6>
          <p class="text-muted small mb-3">Enter the code your teacher gave you.</p>
          <input type="text" id="joinCodeInput" class="form-control text-center fw-bold mb-2"
                 placeholder="e.g. 7K2P9" maxlength="12" autocomplete="off"
                 style="letter-spacing:3px; text-transform:uppercase; font-size:1.2rem;">
          <div id="joinClassError" class="text-danger small mb-2" style="display:none;"></div>
          <div class="d-flex gap-2 mt-2">
            <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary flex-fill" id="joinClassBtn" onclick="joinClass()">Join</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/global.js"></script>
  <%- include('partials/invite-modal') %>
  <script>
    async function joinClass() {
      const input = document.getElementById('joinCodeInput');
      const err = document.getElementById('joinClassError');
      const btn = document.getElementById('joinClassBtn');
      const code = input.value.trim().toUpperCase();
      err.style.display = 'none';
      if (!code) { err.textContent = 'Code required'; err.style.display = 'block'; input.focus(); return; }
      btn.disabled = true; btn.textContent = 'Joining...';
      try {
        const res = await fetch('/api/teach/join', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          credentials: 'include', body: JSON.stringify({ code })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error');
        // Direction vers My account, section "Your mentors", avec highlight du nouveau prof
        const tid = data.classroom && data.classroom.teacher_id;
        btn.textContent = 'Joined ✓';
        window.location.href = '/account' + (tid ? ('?newMentor=' + encodeURIComponent(tid)) : '');
      } catch (e) {
        err.textContent = e.message; err.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Join';
      }
    }

    function initials(name){ return (name||'?').trim().split(/\s+/).slice(0,2).map(w=>w[0]||'').join('').toUpperCase()||'?'; }
    function safeUrl(u){ try{ const x=new URL(u); return (x.protocol==='https:')?x.href:null; }catch{ return null; } }

    const SHOW_FILTERS = false;     // filtres masqués pour l'instant (peu pertinents)
    let ALL_MENTORS = [];
    let activeLang = null;          // null = toutes les langues
    let activePrice = 'any';

    async function loadMentors(){
      const list = document.getElementById('mentors-list');
      try{
        const res = await fetch('/api/mentors', { credentials:'include' });
        const data = await res.json();
        ALL_MENTORS = data.mentors || [];
        if(!ALL_MENTORS.length){
          list.innerHTML = `<div class="empty-state"><div style="font-size:2.6rem;">🧑‍🏫</div><p class="mt-2 mb-0">No teachers listed yet. Check back soon!</p></div>`;
          return;
        }
        if(SHOW_FILTERS){
          buildLangFilters();
          bindPriceFilters();
          document.getElementById('filterCard').style.display = '';
        }
        renderMentors();
      }catch(e){ list.innerHTML = `<div class="empty-state">Loading error</div>`; }
    }

    // Construit les chips de langue à partir des langues réellement enseignées
    function buildLangFilters(){
      const langs = new Set();
      ALL_MENTORS.forEach(m => (m.teaching_languages||[]).forEach(l => langs.add(l)));
      const el = document.getElementById('langFilters');
      const sorted = Array.from(langs).sort((a,b)=>a.localeCompare(b));
      el.innerHTML =
        `<span class="f-chip active" data-lang="">All</span>` +
        sorted.map(l => `<span class="f-chip" data-lang="${escapeHtml(l)}">${escapeHtml(l)}</span>`).join('');
      el.querySelectorAll('.f-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          el.querySelectorAll('.f-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          activeLang = chip.dataset.lang || null;
          renderMentors();
        });
      });
    }

    function bindPriceFilters(){
      const el = document.getElementById('priceFilters');
      el.querySelectorAll('.f-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          el.querySelectorAll('.f-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          activePrice = chip.dataset.price;
          renderMentors();
        });
      });
    }

    function priceMatches(price){
      if (activePrice === 'any') return true;
      if (price == null) return false;         // prix inconnu → exclu des filtres de prix
      if (activePrice === '0-20') return price <= 20;
      if (activePrice === '20-40') return price > 20 && price <= 40;
      if (activePrice === '40+') return price > 40;
      return true;
    }

    function renderMentors(){
      const list = document.getElementById('mentors-list');
      const filtered = ALL_MENTORS.filter(m =>
        (!activeLang || (m.teaching_languages||[]).some(l => l.toLowerCase() === activeLang.toLowerCase())) &&
        priceMatches(m.session_price)
      );

      if(!filtered.length){
        list.innerHTML = `<div class="empty-state"><div style="font-size:2rem;">🔍</div><p class="mt-2 mb-0 small">No teacher matches these filters.</p></div>`;
        return;
      }

      list.innerHTML = filtered.map(m=>{
        const teach = (m.teaching_languages||[]).length
          ? `<div class="mentor-langs"><i class="bi bi-translate me-1"></i>Teaches ${escapeHtml((m.teaching_languages||[]).join(', '))}</div>`
          : (m.languages_spoken ? `<div class="mentor-langs"><i class="bi bi-translate me-1"></i>${escapeHtml(m.languages_spoken)}</div>` : '');
        const bio = m.mentor_bio ? `<div class="mentor-bio">${escapeHtml(m.mentor_bio)}</div>` : '';
        const price = (m.session_price!=null) ? `<span class="m-pill price"><b>${formatMoney(m.session_price, m.session_currency)}</b> / session</span>` : '';

        // Stats secondaires sur une seule ligne, tronquées si trop longues
        const bits = [`${m.student_count} student${m.student_count==1?'':'s'}`,
                      `${m.task_count} course${m.task_count==1?'':'s'}`];
        if(m.years_experience!=null) bits.push(`${m.years_experience} yr${m.years_experience==1?'':'s'}`);
        const stats = `<span class="mentor-stats">${bits.join(' · ')}</span>`;

        let cta = '';
        if(m.link && m.link.url){
          const url = safeUrl(m.link.url);
          if(url){
            const label = m.link.label ? escapeHtml(m.link.label) : 'Contact';
            cta = `<a class="mentor-cta" href="${escapeHtml(url)}" target="_blank" rel="noopener nofollow">${label} <i class="bi bi-box-arrow-up-right"></i></a>`;
          }
        }
        return `<div class="mentor-card">
          <div class="mentor-head">
            <div class="mentor-avatar">${escapeHtml(initials(m.name))}</div>
            <div class="flex-grow-1" style="min-width:0;">
              <div class="mentor-name">${escapeHtml(m.name||'Teacher')}</div>
              ${teach}
            </div>
            ${cta}
          </div>
          ${bio}
          <div class="mentor-footer">
            ${price}
            ${stats}
          </div>
        </div>`;
      }).join('');
      list.classList.add('fade-in');
    }

    const CURRENCY_SYMBOLS = { EUR:'€', USD:'$', GBP:'£', CHF:'CHF', CNY:'¥', JPY:'¥', CAD:'C$', AUD:'A$', SGD:'S$', HKD:'HK$' };
    function formatMoney(p, currency){
      const n = Number(p);
      const amount = Number.isInteger(n) ? String(n) : n.toFixed(2);
      const sym = CURRENCY_SYMBOLS[currency] || (currency || '€');
      // Symbole court (€ $ £ ¥) collé, sinon espacé (CHF 25)
      return sym.length > 1 ? `${sym} ${amount}` : `${sym}${amount}`;
    }

    loadMentors();
  </script>
</body>
</html>
