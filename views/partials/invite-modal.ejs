<!-- Parrainage : carte "Invite" (styles) + modale de partage + logique.
     À inclure une fois par page ; ouvrir avec openInviteModal('friend'|'teacher'). -->
<style>
  /* Duo de CTA côte à côte (existant + invitation) */
  .cta-duo { display:flex; gap:12px; }
  .cta-duo > * { flex:1 1 0; min-width:0; min-height:124px; display:flex; flex-direction:column; justify-content:center; }
  /* Un peu de marge horizontale pour que le texte ne passe pas sous la flèche */
  .cta-duo > * > .text-center { padding-left:18px; padding-right:18px; }

  .invite-launch-card { background:linear-gradient(135deg,#4b5158,#2b2f36); border-radius:16px; color:#fff; cursor:pointer; position:relative; transition:transform .2s ease, box-shadow .2s ease; }
  .invite-launch-arrow { position:absolute; top:10px; right:12px; font-size:1.2rem; color:rgba(255,255,255,.6); transition:transform .25s ease, color .25s ease; pointer-events:none; }
  .invite-launch-title { font-weight:700; font-size:1.1rem; margin-bottom:2px; }
  .invite-launch-text { font-size:.85rem; opacity:.85; }
  @media (hover:hover) { .invite-launch-card:hover { transform:translateY(-3px); box-shadow:0 10px 22px rgba(43,47,54,.28); } .invite-launch-card:hover .invite-launch-arrow { transform:translateX(4px); color:#fff; } }
  .invite-launch-card:active { transform:scale(.97); }

  .invite-link-box { display:flex; align-items:center; gap:8px; background:#f5f7fb; border:1px dashed #cdd9ef; border-radius:12px; padding:8px 10px; }
  .invite-link-text { flex:1; min-width:0; font-family:ui-monospace,monospace; font-size:.82rem; color:#0d6efd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-align:left; }
  .invite-copy { border:none; background:#e7edf7; color:#0d6efd; width:34px; height:34px; border-radius:9px; cursor:pointer; flex-shrink:0; }
  .invite-copy:hover { background:#0d6efd; color:#fff; }
</style>

<div class="modal fade" id="inviteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="border-radius:18px;">
      <div class="modal-body p-4 text-center">
        <div style="font-size:2.5rem;" id="inviteEmoji">🎁</div>
        <h6 class="fw-bold mt-2 mb-1" id="inviteTitle">Invite a friend</h6>
        <p class="text-muted small mb-3" id="inviteSubtitle">Win coins when they join Jiayou.</p>
        <div class="invite-link-box">
          <span id="inviteLink" class="invite-link-text">…</span>
          <button class="invite-copy" id="inviteCopyBtn" onclick="copyInviteLink()" title="Copy"><i class="bi bi-clipboard"></i></button>
        </div>
        <button class="btn btn-primary w-100 mt-3" onclick="shareInvite()"><i class="bi bi-share me-1"></i>Share my link</button>
        <div class="text-muted small mt-3" id="inviteStats"></div>
      </div>
    </div>
  </div>
</div>

<script>
  let _inviteData = null, _inviteMode = 'friend';

  async function openInviteModal(mode) {
    _inviteMode = mode || 'friend';
    const isTeacher = _inviteMode === 'teacher';
    document.getElementById('inviteEmoji').textContent = isTeacher ? '🧑‍🏫' : '🎁';
    document.getElementById('inviteTitle').textContent = isTeacher ? 'Invite your teacher' : 'Invite a friend';
    document.getElementById('inviteSubtitle').textContent = isTeacher
      ? 'Win 150 coins for every teacher who creates an account.'
      : 'Win 80 coins for every friend who joins Jiayou.';

    new bootstrap.Modal(document.getElementById('inviteModal')).show();

    if (!_inviteData) {
      try {
        const res = await fetch('/api/referral', { credentials: 'include' });
        _inviteData = res.ok ? await res.json() : null;
      } catch (e) { _inviteData = null; }
    }
    renderInvite();
  }

  function inviteUrl() {
    return (_inviteData && _inviteData.code)
      ? location.origin + '/?ref=' + encodeURIComponent(_inviteData.code)
      : location.origin;
  }

  function renderInvite() {
    document.getElementById('inviteLink').textContent =
      (_inviteData && _inviteData.code) ? inviteUrl() : 'Unavailable';
    const stats = document.getElementById('inviteStats');
    if (_inviteData) {
      const friends = _inviteData.joined || 0;
      const teachers = _inviteData.teachers || 0;
      const earned = teachers * 150 + Math.max(0, friends - teachers) * 80;
      stats.textContent = friends
        ? `${friends} joined so far · ${earned} coins earned`
        : 'No one has joined yet — share your link!';
    } else {
      stats.textContent = '';
    }
  }

  function copyInviteLink() {
    const btn = document.getElementById('inviteCopyBtn');
    navigator.clipboard.writeText(inviteUrl()).then(() => {
      const o = btn.innerHTML; btn.innerHTML = '<i class="bi bi-check2"></i>';
      setTimeout(() => { btn.innerHTML = o; }, 1400);
    }).catch(() => { prompt('Copy your link:', inviteUrl()); });
  }

  function shareInvite() {
    const isTeacher = _inviteMode === 'teacher';
    const text = isTeacher
      ? 'Join me on Jiayou as a teacher — manage your students and lessons 🎓'
      : 'Learn Chinese with me on Jiayou 加油！🀄';
    const url = inviteUrl();
    if (navigator.share) {
      navigator.share({ title: 'Jiayou 加油！', text, url }).catch(() => {});
    } else {
      window.open('https://wa.me/?text=' + encodeURIComponent(text + ' ' + url), '_blank', 'noopener');
    }
  }
</script>
