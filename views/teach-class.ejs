<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Jiayou Teacher · Class</title>
  <%- include('partials/meta', { pageTitle: 'Jiayou · Class', pageDescription: 'Class tasks and students.' }) %>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background:#f5f7fb; min-height:100vh; }

    /* ── ID card (carte de classe) — style bloc account, compact ── */
    .id-card { background:#fff; border:none; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .id-card-body { padding:1.25rem; }
    .id-name { font-weight:700; font-size:1.1rem; color:#0d6efd; word-break:break-word; }
    .id-code-row { display:inline-flex; align-items:center; gap:8px; }
    .id-code { font-family:ui-monospace,monospace; font-weight:800; letter-spacing:3px; font-size:1.15rem; color:#0d6efd; background:#eef2fb; border:1px dashed #a9c0e8; padding:5px 12px; border-radius:10px; }
    .id-copy { border:none; background:#0d6efd; color:#fff; width:34px; height:34px; border-radius:9px; cursor:pointer; }
    .id-copy:hover { background:#0a58ca; }
    .btn-delete-class { width:100%; margin-top:18px; border:1px solid #f1c2c7; background:#fff; color:#dc3545; font-weight:600; border-radius:12px; padding:9px; }
    .btn-delete-class:hover { background:#dc3545; color:#fff; }
    /* Dropdown élèves */
    .students-drop { background:#fff; border:none; border-radius:16px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .students-drop-head { width:100%; display:flex; align-items:center; justify-content:space-between; background:none; border:none; padding:14px 16px; font-weight:700; color:#0d6efd; cursor:pointer; }
    .students-drop-head .bi-chevron-down { transition:transform .2s ease; }
    .students-drop-head.open .bi-chevron-down { transform:rotate(180deg); }
    .students-drop-body { border-top:1px solid #eef2f8; }
    .student-line { display:flex; align-items:center; gap:12px; padding:10px 14px; border-bottom:1px solid #f2f5fa; }
    .student-line:last-child { border-bottom:none; }
    .btn-revoke { border:1px solid #f1c2c7; background:#fff; color:#dc3545; border-radius:8px; padding:4px 9px; font-size:.75rem; font-weight:600; cursor:pointer; white-space:nowrap; }
    .btn-revoke:hover { background:#dc3545; color:#fff; }
    /* Delete class discret (bas de page) */
    .btn-delete-link { background:none; border:none; color:#b6c0d4; font-size:.82rem; cursor:pointer; }
    .btn-delete-link:hover { color:#dc3545; text-decoration:underline; }
    /* Task cliquable */
    .task-row.clickable { cursor:pointer; transition:transform .1s ease, box-shadow .2s ease; }
    .task-row.clickable:hover { box-shadow:0 6px 16px rgba(10,47,107,0.1); }
    .task-row.clickable:active { transform:scale(.99); }

    /* ── Tabs soulignés ── */
    .tabs2 { display:flex; border-bottom:2px solid #e2e8f4; margin-bottom:16px; }
    .tab2 { padding:12px 18px; background:none; border:none; color:#8a98b5; font-weight:700; font-size:.95rem; border-bottom:3px solid transparent; margin-bottom:-2px; cursor:pointer; transition:color .15s ease, border-color .15s ease; }
    .tab2:hover { color:#5a6b8a; }
    .tab2.active { color:#0d6efd; border-bottom-color:#0d6efd; }

    /* ── Carte "Create task" (style launch duel, marine) ── */
    .task-launch-card { background:linear-gradient(135deg,#0d6efd,#0a58ca); border-radius:16px; color:#fff; cursor:pointer; position:relative; transition:transform .2s ease, box-shadow .2s ease; margin-bottom:16px; }
    .task-launch-arrow { position:absolute; top:10px; right:12px; font-size:1.2rem; color:rgba(255,255,255,.7); transition:transform .25s ease, color .25s ease; pointer-events:none; }
    .task-launch-icon { font-size:2rem; margin-bottom:.4rem; display:block; }
    .task-launch-title { font-weight:700; font-size:1.1rem; margin-bottom:2px; }
    .task-launch-text { font-size:.85rem; opacity:.85; }
    @media (hover:hover) { .task-launch-card:hover { transform:translateY(-3px); box-shadow:0 10px 22px rgba(10,47,107,.28); } .task-launch-card:hover .task-launch-arrow { transform:translateX(4px); color:#fff; } }
    .task-launch-card:active { transform:scale(.97); }

    /* ── Listes ── */
    .task-row, .student-row { background:#fff; border:none; border-radius:16px; padding:14px 16px; margin-bottom:10px; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .task-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
    /* Grille de tasks (2 colonnes) */
    #tasks-list { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
    .task-card { background:#fff; border:none; border-radius:16px; padding:14px 16px; box-shadow:0 2px 12px rgba(0,0,0,0.07); cursor:pointer; transition:transform .1s ease, box-shadow .2s ease; }
    .task-card:hover { box-shadow:0 6px 18px rgba(0,0,0,0.10); }
    .task-card:active { transform:scale(.99); }
    .tk-bar-label { font-size:.64rem; color:#8a98b5; text-transform:uppercase; letter-spacing:.3px; margin-top:12px; }
    .tk-bar { height:8px; border-radius:4px; background:#eef2f8; overflow:hidden; margin-top:4px; }
    .tk-bar > div { height:100%; border-radius:4px; background:#0d6efd; transition:width .4s ease; }
    .tk-pct { font-weight:700; color:#0d6efd; font-size:.78rem; text-align:right; margin-top:3px; }
    .task-title { font-weight:700; color:#0d6efd; }
    .task-meta { font-size:.78rem; color:#8a98b5; }
    .student-row { display:flex; align-items:center; gap:14px; }
    .student-avatar { width:42px; height:42px; border-radius:50%; flex-shrink:0; background:#e7edf7; color:#0d6efd; display:flex; align-items:center; justify-content:center; font-weight:700; }
    .student-name { font-weight:600; color:#1a1a2e; }
    .score-badge { font-weight:700; border-radius:999px; padding:3px 10px; font-size:.8rem; }
    .empty-state { text-align:center; color:#7a8aa8; padding:36px 20px; }
    .modal-content { border-radius:18px; }

    /* ── Modal task : steps ── */
    .step-dots { display:flex; gap:6px; justify-content:center; margin-bottom:16px; }
    .step-dot { width:26px; height:5px; border-radius:3px; background:#dbe3f1; }
    .step-dot.active { background:#0d6efd; }
    .btn-navy { background:#0d6efd; border:none; color:#fff; font-weight:600; }
    .btn-navy:hover { background:#0a58ca; color:#fff; }
    /* Pills */
    .word-pills { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
    .word-pill { display:inline-flex; align-items:center; gap:6px; background:#eef2fb; color:#0d6efd; border:1px solid #cdd9ef; border-radius:999px; padding:6px 14px; font-weight:700; font-size:1.05rem; animation:pillIn .18s ease; }
    .word-pill button { border:none; background:none; color:#7a8aa8; cursor:pointer; padding:0; line-height:1; }
    @keyframes pillIn { from{ opacity:0; transform:scale(.8); } to{ opacity:1; transform:scale(1); } }
    /* Saisie de mot façon dashboard */
    .word-entry { display:flex; align-items:center; gap:10px; background:#fff; border:2px solid #dbe3f1; border-radius:14px; padding:4px 14px; transition:border-color .15s ease; }
    .word-entry:focus-within { border-color:#0d6efd; }
    .word-entry.invalid { border-color:#dc3545; }
    .word-entry-icon { color:#a9b6d1; font-size:1.1rem; }
    .word-entry-input { flex:1; border:none; outline:none; padding:12px 0; font-size:1.3rem; background:transparent; }
    .word-input-error { color:#dc3545; font-size:.8rem; min-height:1.1rem; margin-top:6px; }
    .step-back { background:none; border:none; color:#8a98b5; font-weight:600; font-size:.85rem; padding:0; margin-bottom:10px; cursor:pointer; }
    .step-back:hover { color:#0d6efd; }
    kbd { background:#eef2fb; border:1px solid #cdd9ef; border-radius:5px; padding:1px 6px; font-size:.72rem; color:#0d6efd; }
    /* Cards de traduction */
    .wcard { display:flex; align-items:center; gap:8px; padding:10px 12px; border:1px solid #e7edf7; border-radius:12px; margin-bottom:8px; }
    .wcard.missing { background:#eef4ff; border-color:#cfe0f7; }
    .wcard.found { background:#fff; border-color:#e7edf7; }
    .wcard .wc-cn { font-weight:800; font-size:1.2rem; min-width:52px; }
    .wcard .badge-tag { font-size:.66rem; font-weight:700; padding:2px 7px; border-radius:999px; }
    .badge-found { background:#d4edda; color:#198754; }
    .badge-new { background:#fff3cd; color:#997404; }
  </style>
</head>
<body>
  <%- include('partials/teacher-header') %>

  <div class="container py-3 py-md-4">
    <a href="/teach" class="text-decoration-none text-muted small d-inline-block mb-3"><i class="bi bi-arrow-left me-1"></i>All classes</a>

    <div class="row g-3">
      <!-- Colonne gauche : ID card + create task + élèves + delete -->
      <div class="col-12 col-lg-5">
        <div id="class-card" class="id-card mb-3">
          <div class="id-card-body">
            <div class="skeleton skeleton-title" style="width:60%;"></div>
          </div>
        </div>

        <!-- Create a task (sous l'ID card) -->
        <div class="task-launch-card mb-3" role="button" tabindex="0"
             data-bs-toggle="modal" data-bs-target="#createTaskModal"
             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <i class="task-launch-arrow bi bi-arrow-right-circle-fill"></i>
          <div class="text-center py-3 px-3">
            <div class="task-launch-title">Create a task</div>
            <div class="task-launch-text">Summary + words for your students</div>
          </div>
        </div>

        <!-- Élèves : dropdown -->
        <div class="students-drop mb-3">
          <button class="students-drop-head" onclick="toggleStudents()">
            <span><i class="bi bi-people-fill me-2"></i>Students (<span id="studentCount">–</span>)</span>
            <i class="bi bi-chevron-down" id="studentsChevron"></i>
          </button>
          <div id="students-list" class="students-drop-body" style="display:none;"></div>
        </div>

        <!-- Delete class : desktop → bas de colonne gauche -->
        <div class="text-center mt-2 d-none d-lg-block">
          <button class="btn-delete-link" data-bs-toggle="modal" data-bs-target="#deleteClassModal">
            <i class="bi bi-trash me-1"></i>Delete this class
          </button>
        </div>
      </div>

      <!-- Colonne droite : tasks -->
      <div class="col-12 col-lg-7">
        <h6 class="fw-bold mb-3" style="color:#0d6efd;"><i class="bi bi-journal-text me-2"></i>Tasks</h6>
        <div id="tasks-list">
          <div class="task-card"><div class="skeleton skeleton-title" style="width:60%;"></div><div class="skeleton skeleton-text" style="width:80%;margin-top:12px;"></div></div>
          <div class="task-card"><div class="skeleton skeleton-title" style="width:50%;"></div><div class="skeleton skeleton-text" style="width:80%;margin-top:12px;"></div></div>
        </div>
      </div>
    </div>

    <!-- Delete class : mobile → tout en bas de page -->
    <div class="text-center mt-4 mb-2 d-lg-none">
      <button class="btn-delete-link" data-bs-toggle="modal" data-bs-target="#deleteClassModal">
        <i class="bi bi-trash me-1"></i>Delete this class
      </button>
    </div>
  </div>

  <!-- Modal : créer une task (2 étapes) -->
  <div class="modal fade" id="createTaskModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-body p-4">
          <div class="step-dots"><div class="step-dot active" id="dot1"></div><div class="step-dot" id="dot2"></div><div class="step-dot" id="dot3"></div></div>

          <!-- Étape 1 : titre + résumé -->
          <div id="taskStep1">
            <h5 class="fw-bold mb-1">New task</h5>
            <p class="text-muted small mb-3">Step 1 — Lesson details</p>
            <div class="mb-3">
              <label class="form-label fw-semibold">Title</label>
              <input type="text" id="taskTitle" class="form-control form-control-lg" maxlength="120" placeholder="e.g. Lesson 3 — Family">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Course summary</label>
              <textarea id="taskSummary" class="form-control" rows="4" maxlength="2000" placeholder="What this lesson covers..."></textarea>
            </div>
            <div id="step1Error" class="text-danger small mb-2" style="display:none;"></div>
            <button class="btn btn-navy w-100 py-2" onclick="goStep2()">Next <i class="bi bi-arrow-right ms-1"></i></button>
          </div>

          <!-- Étape 2 : saisie des mots -->
          <div id="taskStep2" style="display:none;">
            <button class="step-back" onclick="backStep1()"><i class="bi bi-arrow-left"></i> Back</button>
            <h5 class="fw-bold mb-1">Add words</h5>
            <p class="text-muted small mb-3">Step 2 — Type a word, press <kbd>Enter</kbd> to stack it</p>
            <div class="word-entry" id="wordEntry">
              <i class="bi bi-plus-lg word-entry-icon"></i>
              <input type="text" id="taskWordInput" class="word-entry-input" autocomplete="off"
                     placeholder="<%= quizDirection === 'zh→en' ? 'Type an English word…' : '输入中文…' %>"
                     oninput="validateWordInput()"
                     onkeydown="if(event.key==='Enter'){event.preventDefault();addPill();}">
            </div>
            <div id="wordInputError" class="word-input-error"></div>
            <div id="wordPills" class="word-pills"></div>
            <div id="step2Error" class="text-danger small my-2" style="display:none;"></div>
            <button class="btn btn-navy w-100 py-2 mt-3" id="fetchWordsBtn" onclick="fetchWords()">
              <i class="bi bi-magic me-1"></i>Fetch the words
            </button>
          </div>

          <!-- Étape 3 : traductions -->
          <div id="taskStep3" style="display:none;">
            <button class="step-back" onclick="backStep2()"><i class="bi bi-arrow-left"></i> Back</button>
            <h5 class="fw-bold mb-1">Translations</h5>
            <p class="text-muted small mb-3">Step 3 — Complete the missing ones, then send</p>
            <div id="wordCards"></div>
            <div id="step3Error" class="text-danger small my-2" style="display:none;"></div>
            <button class="btn btn-navy w-100 py-2 mt-2" id="createTaskBtn" onclick="createTask()">
              <i class="bi bi-send me-1"></i>Send to students
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal suppression classe -->
  <div class="modal fade" id="deleteClassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-body p-4 text-center">
          <div style="font-size:2.4rem;">🗑️</div>
          <h6 class="fw-bold mt-2">Delete this class?</h6>
          <p class="text-muted small mb-3">Students will be unenrolled and tasks deleted. This cannot be undone.</p>
          <div id="deleteError" class="text-danger small mb-2" style="display:none;"></div>
          <div class="d-flex gap-2">
            <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-danger flex-fill" id="confirmDeleteBtn" onclick="deleteClass()">Delete</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/teacher-navbar', { currentPage: 'classes' }) %>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/pinyin-pro.min.js"></script>
  <script src="/js/global.js"></script>
  <script>
    const CLASS_ID = '<%= classId %>';
    let JOIN_CODE = '';

    function scoreColor(s){ if(s>=75)return 'background:#d4edda;color:#198754;'; if(s>=50)return 'background:#fff3cd;color:#997404;'; return 'background:#f8d7da;color:#dc3545;'; }
    function initials(name){ return (name||'?').trim().split(/\s+/).slice(0,2).map(w=>w[0]||'').join('').toUpperCase()||'?'; }
    function autoPinyin(cn){ try{ return (typeof pinyinPro!=='undefined')?pinyinPro.pinyin(cn,{toneType:'symbol',separate:' '}):''; }catch{ return ''; } }

    // ── Classe + élèves ──
    async function loadClass(){
      try{
        const res = await fetch(`/api/teach/classes/${CLASS_ID}`,{credentials:'include'});
        if(!res.ok) throw new Error('not found');
        const data = await res.json();
        JOIN_CODE = data.classroom.join_code;
        renderCard(data.classroom, (data.students||[]).length);
        renderStudents(data.students||[]);
      }catch(e){
        document.getElementById('class-card').innerHTML = '<div class="id-card-body text-danger">Class not found.</div>';
      }
    }

    function renderCard(c, studentCount){
      document.getElementById('class-card').innerHTML = `
        <div class="id-card-body">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="id-name">${escapeHtml(c.name)}</div>
            <div class="id-code-row">
              <span class="id-code">${escapeHtml(c.join_code)}</span>
              <button class="id-copy" onclick="copyCode(this)" title="Copy code"><i class="bi bi-clipboard"></i></button>
            </div>
          </div>
        </div>`;
      document.getElementById('studentCount').textContent = studentCount;
    }

    function copyCode(btn){
      navigator.clipboard.writeText(JOIN_CODE).then(()=>{
        const o = btn.innerHTML; btn.innerHTML = '<i class="bi bi-check2"></i>';
        setTimeout(()=>{ btn.innerHTML = o; }, 1400);
      }).catch(()=>{ prompt('Class code:', JOIN_CODE); });
    }

    function toggleStudents(){
      const body = document.getElementById('students-list');
      const head = document.querySelector('.students-drop-head');
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : '';
      head.classList.toggle('open', !open);
    }

    function renderStudents(students){
      document.getElementById('studentCount').textContent = students.length;
      const list = document.getElementById('students-list');
      if(!students.length){ list.innerHTML = `<div class="empty-state" style="padding:24px;"><p class="mb-0 small">No students yet. Share the code!</p></div>`; return; }
      list.innerHTML = students.map(s=>{
        const score = Number(s.avg_score)||0;
        return `<div class="student-line" id="student-${s.id}">
          <div class="student-avatar">${escapeHtml(initials(s.name))}</div>
          <div class="flex-grow-1" style="min-width:0;">
            <div class="student-name">${escapeHtml(s.name||'Student')}</div>
            <div class="task-meta"><span class="score-badge" style="${scoreColor(score)}">${score}%</span> · ${s.word_count} words</div>
          </div>
          <button class="btn-revoke" onclick="revokeStudent(${s.id}, this)">Revoke</button>
        </div>`;
      }).join('');
    }

    async function revokeStudent(studentId, btn){
      if(!confirm('Remove this student from the class?')) return;
      btn.disabled = true;
      try{
        const res = await fetch(`/api/teach/classes/${CLASS_ID}/students/${studentId}/revoke`,{method:'POST',credentials:'include'});
        if(!res.ok) throw 0;
        const row = document.getElementById('student-'+studentId); if(row) row.remove();
        const cnt = document.getElementById('studentCount'); cnt.textContent = Math.max(0, (parseInt(cnt.textContent,10)||1)-1);
      }catch(e){ btn.disabled = false; }
    }

    // ── Tasks ──
    async function loadTasks(){
      const list = document.getElementById('tasks-list');
      try{
        const res = await fetch(`/api/teach/classes/${CLASS_ID}/lessons`,{credentials:'include'});
        const data = await res.json();
        const tasks = data.lessons||[];
        const tc = document.getElementById('idTaskCount'); if(tc) tc.textContent = tasks.length;
        if(!tasks.length){ list.innerHTML = `<div class="empty-state" style="grid-column:1/-1;"><i class="bi bi-journal" style="font-size:1.5rem;opacity:.35;"></i><p class="mt-2 mb-0 small">No tasks yet.</p></div>`; return; }
        list.innerHTML = tasks.map(t=>{
          const k = Number(t.avg_knowledge)||0;
          return `
          <div class="task-card" onclick="window.location='/teach/task/${t.id}'">
            <div class="task-title text-truncate">${escapeHtml(t.title)}</div>
            <div class="task-meta">${t.word_count} word${t.word_count==1?'':'s'} · ${new Date(t.created_at).toLocaleDateString()}</div>
            <div class="tk-bar-label">Class knowledge</div>
            <div class="tk-bar"><div style="width:${k}%;"></div></div>
            <div class="tk-pct">${k}%</div>
          </div>`;
        }).join('');
      }catch(e){ list.innerHTML = `<div class="empty-state">Loading error</div>`; }
    }

    async function deleteTask(id, btn){
      if(!confirm('Delete this task?')) return;
      btn.disabled = true;
      try{ const res = await fetch(`/api/teach/lessons/${id}`,{method:'DELETE',credentials:'include'}); if(!res.ok)throw 0; loadTasks(); }
      catch(e){ btn.disabled = false; }
    }

    // ── Direction (comme le dashboard) : cours de chinois → saisie chinoise ──
    const LEARN_DIR = '<%= quizDirection %>';
    const IS_ZH_EN = (LEARN_DIR === 'zh→en'); // cours d'anglais

    function wordIsValid(v){
      if(!v) return true;
      if(IS_ZH_EN) return !/[一-鿿㐀-䶿]/.test(v); // anglais : pas de chinois
      return !/[^一-鿿]/.test(v);                          // chinois : que du chinois
    }
    function validateWordInput(){
      const inp = document.getElementById('taskWordInput');
      const entry = document.getElementById('wordEntry');
      const err = document.getElementById('wordInputError');
      if(inp.value && !wordIsValid(inp.value.trim())){
        entry.classList.add('invalid');
        err.textContent = IS_ZH_EN ? 'English words only' : '只能输入中文 · Chinese only';
      } else { entry.classList.remove('invalid'); err.textContent=''; }
    }

    // ── Navigation étapes ──
    function setStep(n){
      document.getElementById('taskStep1').style.display = n===1?'':'none';
      document.getElementById('taskStep2').style.display = n===2?'':'none';
      document.getElementById('taskStep3').style.display = n===3?'':'none';
      [1,2,3].forEach(i=>document.getElementById('dot'+i).classList.toggle('active', i<=n));
    }
    function goStep2(){
      const err = document.getElementById('step1Error'); err.style.display='none';
      if(!document.getElementById('taskTitle').value.trim()){ err.textContent='Title required'; err.style.display='block'; return; }
      setStep(2);
      setTimeout(()=>document.getElementById('taskWordInput').focus(),150);
    }
    function backStep1(){ setStep(1); }
    function backStep2(){ setStep(2); }

    // ── Pills ──
    let pendingWords = [];
    let taskWords = [];   // {chinese, pinyin, english, found}

    function addPill(){
      const inp = document.getElementById('taskWordInput');
      const val = inp.value.trim();
      if(!val) return;
      if(!wordIsValid(val)){ validateWordInput(); return; }
      if(!pendingWords.includes(val)) pendingWords.push(val);
      inp.value=''; validateWordInput(); renderPills();
    }
    function removePill(i){ pendingWords.splice(i,1); renderPills(); }
    function renderPills(){
      document.getElementById('wordPills').innerHTML = pendingWords.map((w,i)=>
        `<span class="word-pill">${escapeHtml(w)} <button onclick="removePill(${i})"><i class="bi bi-x"></i></button></span>`
      ).join('');
    }

    // ── Fetch → étape 3 ──
    async function fetchWords(){
      if(document.getElementById('taskWordInput').value.trim()) addPill();
      const err = document.getElementById('step2Error'); err.style.display='none';
      if(!pendingWords.length){ err.textContent='Add at least one word.'; err.style.display='block'; return; }
      const btn = document.getElementById('fetchWordsBtn'); btn.disabled = true;
      try{
        const res = await fetch('/api/teach/mots/lookup',{
          method:'POST', headers:{'Content-Type':'application/json'}, credentials:'include',
          body: JSON.stringify({ words: pendingWords })
        });
        const data = await res.json();
        (data.results||[]).forEach(r=>{
          const typed = r.input;
          const dupe = taskWords.some(t=> IS_ZH_EN ? t.english===typed : t.chinese===typed);
          if(dupe) return;
          if(r.mot) taskWords.push({chinese:r.mot.chinese, pinyin:r.mot.pinyin||'', english:r.mot.english||'', found:true});
          else if(IS_ZH_EN) taskWords.push({chinese:'', pinyin:'', english:typed, found:false});
          else taskWords.push({chinese:typed, pinyin:autoPinyin(typed), english:'', found:false});
        });
        pendingWords = []; renderPills(); renderWordCards();
        setStep(3);
      }catch(e){ err.textContent='Lookup error'; err.style.display='block'; }
      finally { btn.disabled = false; }
    }

    // ── Cartes de traduction (direction-aware) ──
    function cardIsComplete(w){ return IS_ZH_EN ? !!String(w.chinese).trim() : !!String(w.english).trim(); }
    function renderWordCards(){
      document.getElementById('wordCards').innerHTML = taskWords.map((w,i)=>{
        const ok = cardIsComplete(w);
        const known = (IS_ZH_EN ? escapeHtml(w.english) : escapeHtml(w.chinese)) || '—';
        const fields = IS_ZH_EN
          ? `<input class="form-control form-control-sm" placeholder="汉字 *" value="${escapeHtml(w.chinese||'')}" oninput="taskWords[${i}].chinese=this.value; refreshCard(${i})">
             <input class="form-control form-control-sm" style="max-width:104px;" placeholder="pinyin" value="${escapeHtml(w.pinyin||'')}" oninput="taskWords[${i}].pinyin=this.value">`
          : `<input class="form-control form-control-sm" style="max-width:104px;" placeholder="pinyin" value="${escapeHtml(w.pinyin||'')}" oninput="taskWords[${i}].pinyin=this.value">
             <input class="form-control form-control-sm" placeholder="english *" value="${escapeHtml(w.english||'')}" oninput="taskWords[${i}].english=this.value; refreshCard(${i})">`;
        return `<div class="wcard ${ok?'found':'missing'}" id="wcard-${i}">
          <span class="wc-cn">${known}</span>
          ${fields}
          <button class="btn btn-sm btn-link text-danger p-0" onclick="removeCard(${i})"><i class="bi bi-x-lg"></i></button>
        </div>`;
      }).join('');
    }
    function refreshCard(i){
      const card = document.getElementById('wcard-'+i);
      const ok = cardIsComplete(taskWords[i]);
      card.classList.toggle('found', ok); card.classList.toggle('missing', !ok);
    }
    function removeCard(i){ taskWords.splice(i,1); renderWordCards(); }

    async function createTask(){
      const err = document.getElementById('step3Error'); err.style.display='none';
      const title = document.getElementById('taskTitle').value.trim();
      const summary = document.getElementById('taskSummary').value.trim();
      if(!taskWords.length){ err.textContent='No words to send.'; err.style.display='block'; return; }
      const incomplete = taskWords.find(w=>!cardIsComplete(w));
      if(incomplete){
        const label = IS_ZH_EN ? incomplete.english : incomplete.chinese;
        err.textContent = `Complete the translation for "${label}"`; err.style.display='block'; return;
      }
      const words = taskWords.map(w=>({ chinese:w.chinese, pinyin:w.pinyin, english:w.english }));
      const btn = document.getElementById('createTaskBtn'); btn.disabled = true;
      try{
        const res = await fetch(`/api/teach/classes/${CLASS_ID}/lessons`,{
          method:'POST', headers:{'Content-Type':'application/json'}, credentials:'include',
          body: JSON.stringify({ title, summary, words })
        });
        const data = await res.json();
        if(!res.ok) throw new Error(data.error||'Error');
        resetTaskModal();
        bootstrap.Modal.getInstance(document.getElementById('createTaskModal')).hide();
        loadTasks();
      }catch(e){ err.textContent = e.message; err.style.display='block'; }
      finally{ btn.disabled = false; }
    }

    function resetTaskModal(){
      pendingWords=[]; taskWords=[];
      document.getElementById('taskTitle').value='';
      document.getElementById('taskSummary').value='';
      document.getElementById('taskWordInput').value='';
      document.getElementById('wordInputError').textContent='';
      document.getElementById('wordEntry').classList.remove('invalid');
      document.getElementById('step2Error').style.display='none';
      renderPills(); renderWordCards();
      setStep(1);
    }
    document.getElementById('createTaskModal').addEventListener('hidden.bs.modal', resetTaskModal);

    // ── Delete class ──
    async function deleteClass(){
      const btn = document.getElementById('confirmDeleteBtn'); const err = document.getElementById('deleteError');
      err.style.display='none'; btn.disabled=true; btn.textContent='Deleting...';
      try{
        const res = await fetch(`/api/teach/classes/${CLASS_ID}`,{method:'DELETE',credentials:'include'});
        const data = await res.json(); if(!res.ok) throw new Error(data.error||'Error');
        window.location.href='/teach';
      }catch(e){ err.textContent=e.message; err.style.display='block'; btn.disabled=false; btn.textContent='Delete'; }
    }

    loadClass();
    loadTasks();
  </script>
</body>
</html>
