<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Jiayou Teacher · Task</title>
  <%- include('partials/meta', { pageTitle: 'Jiayou · Task', pageDescription: 'Task progress.' }) %>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background:#f5f7fb; min-height:100vh; }
    .teach-wrap { max-width:820px; margin:0 auto; padding:16px; }
    .panel { background:#fff; border:none; border-radius:16px; padding:18px 20px; margin-bottom:16px; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .task-title-lg { font-weight:800; font-size:1.35rem; color:#0a2f6b; }
    .task-summary { color:#495267; white-space:pre-wrap; margin-top:8px; }
    .word-chip { display:inline-flex; flex-direction:column; align-items:center; background:#eef2fb; border:1px solid #dbe3f1; border-radius:12px; padding:8px 12px; margin:4px; }
    .word-chip .wc-cn { font-weight:800; color:#0a2f6b; font-size:1.15rem; }
    .word-chip .wc-tr { font-size:.72rem; color:#7a8aa8; }
    .sp-row { display:flex; align-items:center; gap:14px; padding:12px 0; border-bottom:1px solid #f2f5fa; }
    .sp-row:last-child { border-bottom:none; }
    .sp-avatar { width:44px; height:44px; border-radius:50%; flex-shrink:0; background:#e7edf7; color:#0a2f6b; display:flex; align-items:center; justify-content:center; font-weight:800; }
    .sp-name { font-weight:700; color:#1a1a2e; }
    .sp-quiz { font-size:.76rem; color:#8a98b5; }
    .sp-bar { height:8px; border-radius:4px; background:#eef2f8; overflow:hidden; margin-top:5px; }
    .sp-bar > div { height:100%; border-radius:4px; background:linear-gradient(90deg,#0a2f6b,#2f6fd6); }
    .sp-pct { font-weight:800; color:#0a2f6b; min-width:44px; text-align:right; }
    .empty-state { text-align:center; color:#7a8aa8; padding:36px 20px; }
  </style>
</head>
<body>
  <%- include('partials/teacher-header') %>

  <div class="container py-3 py-md-4">
    <a id="backLink" href="/teach" class="text-decoration-none text-muted small d-inline-block mb-3"><i class="bi bi-arrow-left me-1"></i>Back to class</a>

    <div id="task-panel" class="panel">
      <div class="skeleton skeleton-title" style="width:50%;"></div>
      <div class="skeleton skeleton-text" style="width:80%; margin-top:10px;"></div>
    </div>

    <div class="panel">
      <h6 class="fw-bold mb-3" style="color:#0a2f6b;"><i class="bi bi-people-fill me-2"></i>Student progress</h6>
      <div id="progress-list">
        <div class="sp-row"><div class="skeleton skeleton-circle" style="width:44px;height:44px;"></div><div class="flex-grow-1"><div class="skeleton skeleton-text" style="width:40%;"></div><div class="skeleton skeleton-text" style="width:70%;"></div></div></div>
      </div>
    </div>
  </div>

  <!-- Modal suppression task -->
  <div class="modal fade" id="deleteTaskModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content" style="border-radius:18px;">
        <div class="modal-body p-4 text-center">
          <div style="font-size:2.4rem;">🗑️</div>
          <h6 class="fw-bold mt-2">Delete this task?</h6>
          <p class="text-muted small mb-3">This removes the task and its progress. This cannot be undone.</p>
          <div class="d-flex gap-2">
            <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-danger flex-fill" id="confirmDeleteTaskBtn" onclick="deleteTask()">Delete</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/teacher-navbar', { currentPage: 'classes' }) %>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/global.js"></script>
  <script>
    const LESSON_ID = '<%= lessonId %>';
    function initials(name){ return (name||'?').trim().split(/\s+/).slice(0,2).map(w=>w[0]||'').join('').toUpperCase()||'?'; }

    async function loadProgress(){
      try{
        const res = await fetch(`/api/teach/lessons/${LESSON_ID}/progress`,{credentials:'include'});
        if(!res.ok) throw new Error('not found');
        const data = await res.json();
        renderTask(data.lesson, data.words||[]);
        renderProgress(data.students||[]);
      }catch(e){
        document.getElementById('task-panel').innerHTML = '<div class="text-danger">Task not found.</div>';
        document.getElementById('progress-list').innerHTML = '';
      }
    }

    let CLASS_ID = null;
    function renderTask(lesson, words){
      CLASS_ID = lesson.classroom_id;
      document.getElementById('backLink').href = `/teach/class/${lesson.classroom_id}`;
      const chips = words.map(w=>`
        <span class="word-chip">
          <span class="wc-cn">${escapeHtml(w.chinese)}</span>
          <span class="wc-tr">${escapeHtml(w.pinyin||'')} · ${escapeHtml(w.english||'')}</span>
        </span>`).join('');
      document.getElementById('task-panel').innerHTML = `
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div class="task-title-lg">${escapeHtml(lesson.title)}</div>
          <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteTaskModal" title="Delete task"><i class="bi bi-trash"></i></button>
        </div>
        <div class="text-muted small">${new Date(lesson.created_at).toLocaleDateString()} · ${words.length} word${words.length==1?'':'s'}</div>
        ${lesson.summary ? `<div class="task-summary">${escapeHtml(lesson.summary)}</div>` : ''}
        <div class="mt-3">${chips || '<span class="text-muted small">No words.</span>'}</div>`;
    }

    async function deleteTask(){
      const btn = document.getElementById('confirmDeleteTaskBtn');
      btn.disabled = true; btn.textContent = 'Deleting...';
      try{
        const res = await fetch(`/api/teach/lessons/${LESSON_ID}`, { method:'DELETE', credentials:'include' });
        if(!res.ok) throw 0;
        window.location.href = CLASS_ID ? `/teach/class/${CLASS_ID}` : '/teach';
      }catch(e){ btn.disabled=false; btn.textContent='Delete'; }
    }

    function renderProgress(students){
      const list = document.getElementById('progress-list');
      if(!students.length){
        list.innerHTML = `<div class="empty-state"><i class="bi bi-people" style="font-size:1.5rem;opacity:.35;"></i><p class="mt-2 mb-0 small">No students in this class yet.</p></div>`;
        return;
      }
      list.innerHTML = students.map(s=>{
        const k = Number(s.knowledge)||0;
        return `<div class="sp-row">
          <div class="sp-avatar">${escapeHtml(initials(s.name))}</div>
          <div class="flex-grow-1" style="min-width:0;">
            <div class="sp-name">${escapeHtml(s.name||'Student')}</div>
            <div class="sp-quiz"><i class="bi bi-controller"></i> ${s.quiz_count} quiz${s.quiz_count==1?'':'zes'} on this task</div>
            <div class="sp-bar"><div style="width:${k}%;"></div></div>
          </div>
          <div class="sp-pct">${k}%</div>
        </div>`;
      }).join('');
    }

    loadProgress();
  </script>
</body>
</html>
