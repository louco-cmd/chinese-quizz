<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Jiayou Teacher</title>
  <%- include('partials/meta', { pageTitle: 'Jiayou · Teacher', pageDescription: 'Manage your classes and follow your students.' }) %>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background:#f5f7fb; min-height:100vh; }

    /* ── Header ID : stats globales (style bloc account) ── */
    .stats-card { background:#fff; border:none; border-radius:16px; padding:1.25rem; box-shadow:0 2px 12px rgba(0,0,0,0.07); }
    .stats-title { font-weight:800; color:#0d6efd; font-size:1.05rem; }
    .stats-sub { font-size:.76rem; color:#8a98b5; margin-bottom:12px; }
    .stats-pills { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .stat-pill { background:#f5f7fb; border:1px solid #eef2f8; border-radius:12px; padding:10px 6px; text-align:center; }
    .stat-pill.wide { grid-column:1 / -1; }
    .stat-pill .n { font-weight:800; font-size:1.2rem; color:#0d6efd; line-height:1; }
    .stat-pill .l { font-size:.64rem; color:#8a98b5; text-transform:uppercase; letter-spacing:.3px; margin-top:4px; }
    @media (min-width:992px) { .stats-sticky { position:sticky; top:16px; } }

    /* ── New class (carte façon "new task", marine) ── */
    .task-launch-card { background:linear-gradient(135deg,#0d6efd,#0a58ca); border-radius:16px; color:#fff; cursor:pointer; position:relative; transition:transform .2s ease, box-shadow .2s ease; margin-bottom:16px; }
    .task-launch-arrow { position:absolute; top:10px; right:12px; font-size:1.2rem; color:rgba(255,255,255,.7); transition:transform .25s ease, color .25s ease; pointer-events:none; }
    .task-launch-icon { font-size:2rem; margin-bottom:.4rem; display:block; }
    .task-launch-title { font-weight:700; font-size:1.1rem; margin-bottom:2px; }
    .task-launch-text { font-size:.85rem; opacity:.85; }
    @media (hover:hover) { .task-launch-card:hover { transform:translateY(-3px); box-shadow:0 10px 22px rgba(10,47,107,.28); } .task-launch-card:hover .task-launch-arrow { transform:translateX(4px); color:#fff; } }
    .task-launch-card:active { transform:scale(.97); }

    /* ── Cartes de classe ── */
    .class-card { background:#fff; border:none; border-radius:16px; padding:16px 18px; margin-bottom:12px; box-shadow:0 2px 12px rgba(0,0,0,0.07); cursor:pointer; transition:transform .1s ease, box-shadow .2s ease; }
    .class-card:hover { box-shadow:0 6px 18px rgba(0,0,0,0.10); }
    .class-card:active { transform:scale(.99); }
    .cc-name { font-weight:800; font-size:1.1rem; color:#0d6efd; word-break:break-word; }
    .cc-pills { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
    .cc-pill { background:#eef2fb; border:1px solid #dbe3f1; border-radius:999px; padding:4px 12px; font-size:.82rem; color:#5a6b8a; }
    .cc-pill b { color:#0d6efd; }
    .cc-code { display:inline-flex; align-items:center; gap:8px; margin-top:12px; }
    .cc-code .code { font-family:ui-monospace,monospace; font-weight:800; letter-spacing:3px; color:#0d6efd; background:#f5f7fb; border:1px dashed #a9c0e8; padding:4px 12px; border-radius:10px; }
    .cc-copy { border:none; background:#eef2fb; color:#0d6efd; width:34px; height:34px; border-radius:9px; cursor:pointer; }
    .cc-copy:hover { background:#0d6efd; color:#fff; }
    .empty-state { text-align:center; color:#7a8aa8; padding:40px 20px; }
    .btn-navy { background:#0d6efd; border:none; color:#fff; font-weight:600; }
    .btn-navy:hover { background:#0a58ca; color:#fff; }
    .modal-content { border-radius:18px; }
  </style>
</head>
<body>
  <%- include('partials/teacher-header') %>

  <div class="container py-3 py-md-4">
    <div class="row g-3">
      <!-- Header ID : stats (sticky en desktop) -->
      <div class="col-12 col-lg-4">
        <div class="stats-card stats-sticky">
          <div class="stats-title"><%= user.name || 'Teacher' %></div>
          <div class="stats-sub">Your teaching at a glance</div>
          <div class="stats-pills">
            <div class="stat-pill"><div class="n" id="stClasses">–</div><div class="l">Classes</div></div>
            <div class="stat-pill"><div class="n" id="stStudents">–</div><div class="l">Students</div></div>
            <div class="stat-pill"><div class="n" id="stTasks">–</div><div class="l">Tasks</div></div>
            <div class="stat-pill wide"><div class="n" id="stKnowledge">–</div><div class="l">Student average knowledge</div></div>
          </div>
        </div>
      </div>

      <!-- Classes -->
      <div class="col-12 col-lg-8">
        <!-- New class : carte façon "new task" -->
        <div class="task-launch-card" role="button" tabindex="0"
             data-bs-toggle="modal" data-bs-target="#createClassModal"
             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <i class="task-launch-arrow bi bi-arrow-right-circle-fill"></i>
          <div class="text-center py-3 px-3">
            <div class="task-launch-title">New class</div>
            <div class="task-launch-text">Create a class and invite students</div>
          </div>
        </div>

        <div id="classes-list">
          <div class="class-card"><div class="skeleton skeleton-title" style="width:40%;"></div><div class="skeleton skeleton-text" style="width:25%;"></div></div>
          <div class="class-card"><div class="skeleton skeleton-title" style="width:50%;"></div><div class="skeleton skeleton-text" style="width:25%;"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Modal : créer une classe ── -->
  <div class="modal fade" id="createClassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body p-4">
          <h5 class="fw-bold mb-3">New class</h5>
          <div class="mb-3">
            <label class="form-label">Class name</label>
            <input type="text" id="newClassName" class="form-control form-control-lg" placeholder="e.g. Beginner HSK1 — Tuesday" maxlength="80">
          </div>
          <div id="createClassError" class="text-danger small mb-2" style="display:none;"></div>
          <div class="d-flex gap-2">
            <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-navy flex-fill" id="createClassBtn" onclick="createClass()">Create</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/teacher-navbar', { currentPage: 'classes' }) %>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/global.js"></script>
  <script>
    async function loadOverview() {
      try {
        const res = await fetch('/api/teach/overview', { credentials: 'include' });
        const d = await res.json();
        document.getElementById('stClasses').textContent = d.classes ?? 0;
        document.getElementById('stStudents').textContent = d.students ?? 0;
        document.getElementById('stTasks').textContent = d.tasks ?? 0;
        document.getElementById('stKnowledge').textContent = (d.avg_knowledge ?? 0) + '%';
      } catch (e) { /* ignore */ }
    }

    async function loadClasses() {
      const list = document.getElementById('classes-list');
      try {
        const res = await fetch('/api/teach/classes', { credentials: 'include' });
        const data = await res.json();
        const classes = data.classrooms || [];
        if (!classes.length) {
          list.innerHTML = `<div class="empty-state"><i class="bi bi-easel2" style="font-size:1.5rem;opacity:.35;"></i><p class="mt-2 mb-0 small">No classes yet. Create your first one!</p></div>`;
          return;
        }
        list.innerHTML = classes.map(renderClass).join('');
        list.classList.add('fade-in');
      } catch (e) {
        list.innerHTML = `<div class="empty-state">Loading error</div>`;
      }
    }

    function renderClass(c) {
      return `
        <div class="class-card" onclick="window.location='/teach/class/${c.id}'">
          <div class="d-flex justify-content-between align-items-start">
            <div class="cc-name">${escapeHtml(c.name)}</div>
            <i class="bi bi-chevron-right text-muted"></i>
          </div>
          <div class="cc-pills">
            <span class="cc-pill"><b>${c.student_count}</b> student${c.student_count == 1 ? '' : 's'}</span>
            <span class="cc-pill"><b>${c.lesson_count}</b> task${c.lesson_count == 1 ? '' : 's'}</span>
          </div>
          <div class="cc-code" onclick="event.stopPropagation()">
            <span class="code">${escapeHtml(c.join_code)}</span>
            <button class="cc-copy" onclick="copyCode('${escapeHtml(c.join_code)}', this)" title="Copy code"><i class="bi bi-clipboard"></i></button>
          </div>
        </div>`;
    }

    function copyCode(code, btn) {
      navigator.clipboard.writeText(code).then(() => {
        const o = btn.innerHTML; btn.innerHTML = '<i class="bi bi-check2"></i>';
        setTimeout(() => { btn.innerHTML = o; }, 1400);
      }).catch(() => { prompt('Class code:', code); });
    }

    async function createClass() {
      const name = document.getElementById('newClassName').value.trim();
      const errEl = document.getElementById('createClassError');
      const btn = document.getElementById('createClassBtn');
      errEl.style.display = 'none';
      if (!name) { errEl.textContent = 'Class name required'; errEl.style.display = 'block'; return; }
      btn.disabled = true;
      try {
        const res = await fetch('/api/teach/classes', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          credentials: 'include', body: JSON.stringify({ name })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error');
        bootstrap.Modal.getInstance(document.getElementById('createClassModal')).hide();
        document.getElementById('newClassName').value = '';
        loadClasses(); loadOverview();
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      } finally {
        btn.disabled = false;
      }
    }

    loadOverview();
    loadClasses();
  </script>
</body>
</html>
